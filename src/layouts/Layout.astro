---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Zach 的 AI 與數學學習部落格" } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-800 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white border-b border-stone-200 sticky top-0 z-50">
      <div class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-stone-900 hover:text-stone-600 transition-colors">
          Zach's Blog
        </a>
        <div class="flex items-center gap-6">
          <a href="/" class="text-stone-600 hover:text-stone-900 transition-colors">Home</a>
          <a href="/about" class="text-stone-600 hover:text-stone-900 transition-colors">About</a>
          <a href="/newsletter" class="text-stone-600 hover:text-stone-900 transition-colors">Newsletter</a>
        </div>
      </div>
    </nav>

    <!-- Social Links Bar -->
    <div class="bg-white border-b border-stone-100">
      <div class="max-w-3xl mx-auto px-4 py-2 flex items-center gap-4 text-stone-400">
        <a href="https://github.com/ai-lish" target="_blank" rel="noopener" class="hover:text-stone-600 transition-colors" title="GitHub">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="mailto:zach@example.com" class="hover:text-stone-600 transition-colors" title="Email">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </a>
      </div>
    </div>

    <!-- Main Content -->
    <main class="max-w-3xl mx-auto px-4 py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200 bg-white mt-16">
      <div class="max-w-3xl mx-auto px-4 py-6 text-center text-stone-500 text-sm">
        © 2026 Zach Li. 用 Astro 架設。
      </div>
    </footer>
  </body>
</html>