---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const records = (await getCollection('posts', ({ data }) => data.category === 'material-design'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="教材設計記錄 | Zach's Blog" description="記錄數學教材的學習目標、設計思路、活動安排、試用觀察與修訂。">
  <section class="home-intro" aria-labelledby="records-title">
    <div>
      <p class="eyebrow">教學實踐 · 設計筆記</p>
      <h1 id="records-title">教材設計記錄</h1>
      <p class="home-intro-copy">每份教材都有一個想解決的學習問題。這裏記下設計的起點、活動與題目的取捨，以及試用後值得保留或修改的地方。</p>
    </div>
    <p class="home-intro-note"><span>記錄重點</span>目標 → 設計 → 試用 → 修訂</p>
  </section>

  <section class="archive-section" aria-labelledby="records-list-title">
    <div class="section-heading">
      <h2 id="records-list-title">所有記錄</h2>
      <span class="section-count">{records.length} 篇</span>
    </div>
    <div class="post-list">
      {records.map((post) => (
        <a class="post-row" href={`${base}posts/${post.id}/`}>
          <span class="post-row-arrow" aria-hidden="true">↗</span>
          <span class="post-row-copy">
            <span class="post-label">教材設計記錄</span>
            <h3>{post.data.title}</h3>
            {post.data.description && <span>{post.data.description}</span>}
          </span>
          <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('zh-Hant', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        </a>
      ))}
    </div>
    {records.length === 0 && <p class="empty-state">暫時未有教材設計記錄。</p>}
  </section>
</Layout>
