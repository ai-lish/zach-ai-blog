---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ViewCount from '../components/ViewCount.astro';
import { AI_WORKFLOW_TIMELINE } from '../data/ai-workflow-timeline';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const allPosts = await getCollection('posts');
const materialRecordCount = allPosts.filter(({ data }) => data.category === 'material-design').length;
const experimentCount = allPosts.length - materialRecordCount;
const timelineStages = AI_WORKFLOW_TIMELINE.map((period) => ({
  period,
  posts: allPosts
    .filter(({ data }) => data.developmentStages?.includes(period.id))
    .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-Hant')),
}));
const mappedPostIds = new Set(timelineStages.flatMap(({ posts }) => posts.map(({ id }) => id)));
const unconfirmedPosts = allPosts
  .filter(({ id }) => !mappedPostIds.has(id))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'zh-Hant'));
const formatDate = (date: Date) => date.toLocaleDateString('zh-Hant', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const categoryLabel = (category: string) => category === 'material-design' ? '教材設計記錄' : '文章筆記';
---

<Layout title="Zach's Blog - AI 與數學學習" description="Zach 的 AI 與數學學習部落格">
  <section class="home-intro" aria-labelledby="home-title">
    <div class="home-intro-main">
      <p class="eyebrow">AI 工具 · 數學學習</p>
      <h1 id="home-title">把複雜工具，寫成可重用的做法。</h1>
      <p class="home-intro-copy">
        記錄實際試過的工具、流程與判斷，讓下一次遇到同一個問題時，可以少走一點彎路。
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#development-timeline">按發展階段瀏覽 <span aria-hidden="true">↘</span></a>
        <a class="button button-quiet" href={`${base}material-design/`}>看教材設計記錄</a>
      </div>
    </div>
    <aside class="home-intro-note">
      <div class="note-heading"><span>正在建立</span><span class="note-index">01</span></div>
      <strong>一個可重用的教學實驗檔案。</strong>
      <p>從第一個 prompt 到最後一次 review，把決定留下來，讓教材可以繼續進步。</p>
      <span class="note-rule" aria-hidden="true"></span>
      <span class="note-meta">香港 · 持續更新</span>
    </aside>
  </section>

  <section class="home-stats" aria-label="網站概覽">
    <div class="stat-card"><span class="stat-value">{experimentCount}</span><span class="stat-label">篇實驗筆記</span></div>
    <div class="stat-card"><span class="stat-value">{materialRecordCount}</span><span class="stat-label">份教材記錄</span></div>
    <div class="stat-card"><span class="stat-value">AI × Math</span><span class="stat-label">主要探索方向</span></div>
  </section>

  <section id="development-timeline" class="archive-section home-development-timeline" aria-labelledby="development-timeline-title">
    <div class="section-heading">
      <div><p class="section-kicker">文章索引</p><h2 id="development-timeline-title">按實際發展階段瀏覽</h2></div>
      <span class="section-count">{allPosts.length} 篇文章</span>
    </div>
    <p class="home-development-timeline-intro">
      時段依已記錄的發展階段排列；每篇文章的發表日期只作資訊，不用來推定所屬時段。一篇文章可以出現在多個階段。未能核實時段的文章列於時間線末端。
    </p>

    <ol class="development-stage-list">
      {timelineStages.map(({ period, posts }) => (
        <li id={`stage-${period.id}`} class="development-stage">
          <header class="development-stage-heading">
            <p class="development-stage-date">{period.dateLabel}</p>
            <h3>{period.title}</h3>
          </header>
          <div class="development-stage-content">
            {period.tabs.flatMap((tab) => tab.paragraphs).map((paragraph) => (
              <p class="development-stage-summary">{paragraph}</p>
            ))}
            {posts.length > 0 ? (
              <div class="post-list development-stage-posts">
                {posts.map((post) => (
                  <a class="post-row" href={`${base}posts/${post.id}/`}>
                    <span class="post-row-arrow" aria-hidden="true">↗</span>
                    <span class="post-row-copy">
                      <span class="post-label">{categoryLabel(post.data.category)}</span>
                      <h3>{post.data.title}</h3>
                      {post.data.description && <span>{post.data.description}</span>}
                    </span>
                    <span class="post-row-meta">
                      <time datetime={post.data.pubDate.toISOString()}>發表 {formatDate(post.data.pubDate)}</time>
                      <ViewCount path={`${base}posts/${post.id}/`} label="瀏覽" />
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="development-stage-empty">目前未有文章連結到這個階段。</p>
            )}
          </div>
        </li>
      ))}

      <li id="stage-to-confirm" class="development-stage development-stage-unconfirmed">
        <header class="development-stage-heading">
          <p class="development-stage-date">時期待確認</p>
          <h3>未能核實所屬階段</h3>
        </header>
        <div class="development-stage-content">
          <p class="development-stage-summary">
            這些文章目前沒有足夠的內容證據連結到以上時段。發表日期會保留為文章資訊，不作階段推定。
          </p>
          {unconfirmedPosts.length > 0 ? (
            <div class="post-list development-stage-posts">
              {unconfirmedPosts.map((post) => (
                <a class="post-row" href={`${base}posts/${post.id}/`}>
                  <span class="post-row-arrow" aria-hidden="true">↗</span>
                  <span class="post-row-copy">
                    <span class="post-label">{categoryLabel(post.data.category)}</span>
                    <h3>{post.data.title}</h3>
                    {post.data.description && <span>{post.data.description}</span>}
                  </span>
                  <span class="post-row-meta">
                    <time datetime={post.data.pubDate.toISOString()}>發表 {formatDate(post.data.pubDate)}</time>
                    <ViewCount path={`${base}posts/${post.id}/`} label="瀏覽" />
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p class="development-stage-empty">目前所有文章均已連結到已記錄階段。</p>
          )}
        </div>
      </li>
    </ol>
  </section>

  <section class="archive-section purpose-section" aria-labelledby="material-design-title">
    <div class="section-heading">
      <div><p class="section-kicker">專題檔案</p><h2 id="material-design-title">教材設計記錄</h2></div>
      <a class="read-link" href={`${base}material-design/`}>查看記錄 <span aria-hidden="true">↗</span></a>
    </div>
    <p class="home-intro-copy">由學習目標、題目與互動活動，到試用觀察及修訂，記下每份教材背後的設計思路。</p>
  </section>
</Layout>
