---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featuredPost = posts[0];
const otherPosts = posts.slice(1);
const formatDate = (date: Date) => date.toLocaleDateString('zh-Hant', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title="Zach's Blog - AI 與數學學習" description="Zach 的 AI 與數學學習部落格">
  <section class="home-intro" aria-labelledby="home-title">
    <div>
      <p class="eyebrow">AI 工具 · 數學學習</p>
      <h1 id="home-title">把複雜工具，寫成可重用的做法。</h1>
      <p class="home-intro-copy">
        記錄實際試過的工具、流程與判斷，讓下一次遇到同一個問題時，可以少走一點彎路。
      </p>
    </div>
    <p class="home-intro-note">
      <span>更新節奏</span>
      有新實驗，就寫一篇。
    </p>
  </section>

  {featuredPost && (
    <section class="featured-section" aria-labelledby="featured-title">
      <div class="section-heading">
        <p class="section-kicker">最新實驗</p>
        <span class="section-count">{formatDate(featuredPost.data.pubDate)}</span>
      </div>

      <a class="feature-story" href={`${base}posts/${featuredPost.id}/`}>
        <div class="feature-media">
          {featuredPost.data.cover ? (
            <img
              src={`${base}${featuredPost.data.cover}`}
              alt={featuredPost.data.title}
              loading="eager"
            />
          ) : (
            <img src={`${base}images/placeholder.svg`} alt="" loading="eager" />
          )}
        </div>
        <div class="feature-copy">
          <p class="post-label">本地 AI 實戰</p>
          <h2 id="featured-title">{featuredPost.data.title}</h2>
          {featuredPost.data.description && (
            <p class="feature-description">{featuredPost.data.description}</p>
          )}
          <span class="read-link">閱讀全文 <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </section>
  )}

  {otherPosts.length > 0 && (
    <section class="archive-section" aria-labelledby="archive-title">
      <div class="section-heading">
        <h2 id="archive-title">其他文章</h2>
        <span class="section-count">{otherPosts.length} 篇</span>
      </div>

      <div class="post-list">
        {otherPosts.map((post) => (
          <a class="post-row" href={`${base}posts/${post.id}/`}>
            <span class="post-row-arrow" aria-hidden="true">↗</span>
            <span class="post-row-copy">
              <span class="post-label">筆記</span>
              <h3>{post.data.title}</h3>
              {post.data.description && <span>{post.data.description}</span>}
            </span>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          </a>
        ))}
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <p class="empty-state">暫時未有文章。</p>
  )}
</Layout>
