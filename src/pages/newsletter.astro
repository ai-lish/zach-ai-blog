---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Newsletter - Zach's Blog" description="訂閱 Zach's Blog，收到新文章通知">
  <article class="bg-white rounded-lg border border-stone-200 p-8 max-w-xl mx-auto dark:bg-[#242424] dark:border-[#333333]">
    <h1 class="text-3xl font-bold text-stone-900 mb-4 dark:text-[#F5F0EB]" style="font-family: 'Playfair Display', Georgia, serif;">
      Newsletter
    </h1>
    <p class="text-stone-600 mb-6 leading-relaxed dark:text-[#A8A29E]">
      訂閱我的 Newsletter，當有新文章時我會通知你。不會 spam，只係有新野先寫比你。
    </p>

    <form class="space-y-4" onsubmit="handleSubscribe(event)">
      <div>
        <label for="email" class="block text-sm font-medium text-stone-700 mb-1 dark:text-[#A8A29E]">
          電郵地址
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          placeholder="your@email.com"
          class="w-full px-4 py-2.5 border border-stone-300 rounded-lg focus:ring-2 focus:ring-[#5B8A8A] focus:border-[#5B8A8A] outline-none transition-shadow dark:bg-[#1A1A1A] dark:border-[#333333] dark:text-[#F5F0EB] dark:placeholder-[#78716C]"
        />
      </div>
      <button
        type="submit"
        class="w-full bg-[#5B8A8A] text-white py-2.5 px-4 rounded-lg font-medium hover:bg-[#4A7575] active:bg-[#3D6464] transition-colors"
      >
        訂閱
      </button>
    </form>

    <p class="text-stone-400 text-xs mt-4 dark:text-[#78716C]">
      暫時用 mailto form，你可以留任何 email，我会手动处理。
    </p>
  </article>

  <script is:inline>
    function handleSubscribe(event) {
      event.preventDefault();
      const email = document.getElementById('email').value;
      window.location.href = `mailto:zach@example.com?subject=Newsletter Subscribe&body=Hi, I'd like to subscribe with: ${email}`;
      alert('已開啟郵件程式，請發送以完成訂閱！');
    }
  </script>
</Layout>
