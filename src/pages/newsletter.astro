---
import Layout from '../layouts/Layout.astro';
---

<Layout title="訂閱 | Zach's Blog" description="訂閱 Zach's Blog，收到新的 AI、數學與教材設計記錄。">
  <section class="newsletter-shell" aria-labelledby="newsletter-title">
    <div class="newsletter-card">
      <p class="eyebrow">保持聯絡</p>
      <h1 id="newsletter-title">有新實驗，通知你。</h1>
      <p class="newsletter-lead">訂閱後，我會在有新文章或教材設計記錄時寄一封短訊息。不定期、不灌水，內容會保留實際做過的步驟和結果。</p>

      <form class="newsletter-form" onsubmit="handleSubscribe(event)">
        <label for="email">電郵地址</label>
        <div class="newsletter-input-row">
          <input type="email" id="email" name="email" required placeholder="your@email.com" autocomplete="email" />
          <button class="button button-primary" type="submit">訂閱 <span aria-hidden="true">↗</span></button>
        </div>
      </form>
      <p class="newsletter-note">目前會開啟郵件程式完成訂閱，之後由我手動處理。</p>
    </div>
    <div class="newsletter-side" aria-hidden="true">
      <span class="side-number">03</span>
      <span class="side-line"></span>
      <strong>AI<br />×<br />教學</strong>
    </div>
  </section>

  <script is:inline>
    function handleSubscribe(event) {
      event.preventDefault();
      const email = document.getElementById('email').value;
      window.location.href = `mailto:zach@example.com?subject=Newsletter Subscribe&body=Hi, I'd like to subscribe with: ${encodeURIComponent(email)}`;
    }
  </script>
</Layout>
