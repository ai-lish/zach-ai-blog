---
import type { CollectionEntry } from 'astro:content';
import { IDEA_STAGES, type IdeaStageId } from '../data/idea-stages';

type Idea = NonNullable<CollectionEntry<'posts'>['data']['idea']>;

interface Props {
  idea: Idea;
}

const { idea } = Astro.props;
const currentStageIndex = IDEA_STAGES.findIndex((stage) => stage.id === idea.status);
const orderedLog = [...idea.log].sort((a, b) => a.date.valueOf() - b.date.valueOf());
const lastUpdate = idea.log.reduce(
  (latest, entry) => entry.date.valueOf() > latest.valueOf() ? entry.date : latest,
  idea.log[0]!.date,
);
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const formatDate = (date: Date) => date.toLocaleDateString('zh-Hant', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const stageLabel = (id: IdeaStageId) => IDEA_STAGES.find((stage) => stage.id === id)!.label;
---

<section class="idea-progress" aria-labelledby="idea-progress-title">
  <div class="idea-progress-heading">
    <h2 id="idea-progress-title">想法進度</h2>
  </div>

  <ol class="idea-progress-stages" aria-label="想法發展階段">
    {IDEA_STAGES.map((stage, index) => {
      const state = index < currentStageIndex ? 'complete' : index === currentStageIndex ? 'current' : 'upcoming';
      return (
        <li class:list={['idea-progress-stage', `is-${state}`]} aria-current={state === 'current' ? 'step' : undefined}>
          <span class="idea-stage-marker" aria-hidden="true">{state === 'complete' ? '✓' : index + 1}</span>
          <span class="idea-stage-name">{stage.label}</span>
          {state === 'complete' && <span class="idea-stage-state">已完成</span>}
          {state === 'current' && <span class="idea-stage-state">目前</span>}
        </li>
      );
    })}
  </ol>

  <ol class="idea-progress-log" aria-label="想法更新紀錄">
    {orderedLog.map((entry) => (
      <li class="idea-progress-log-entry">
        <div class="idea-progress-log-meta">
          <time datetime={entry.date.toISOString()}>{formatDate(entry.date)}</time>
          <span class="idea-stage-badge">{stageLabel(entry.stage)}</span>
        </div>
        <p>{entry.summary}</p>
      </li>
    ))}
  </ol>

  <p class="idea-last-updated">最後更新：<time datetime={lastUpdate.toISOString()}>{formatDate(lastUpdate)}</time></p>
  <a class="back-link idea-back-link" href={`${base}ideas/`}>← 返回想法頁</a>
</section>
